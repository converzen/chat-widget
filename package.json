{
  "name": "@converzen/chat-widget",
  "version": "1.1.0",
  "description": "Drop-in chat widget SDK for ConverZen - Easy to integrate, customizable, and fully featured chat widget",
  "main": "./dist/cvz-widget.js",
  "module": "./dist/cvz-widget.mjs",
  "browser": "./dist/cvz-widget.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/cvz-widget.d.mts",
        "default": "./dist/cvz-widget.mjs"
      },
      "require": {
        "types": "./dist/cvz-widget.d.ts",
        "default": "./dist/cvz-widget.js"
      },
      "default": "./dist/cvz-widget.js"
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.mts",
        "default": "./dist/core.mjs"
      },
      "require": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.mts",
        "default": "./dist/react.mjs"
      },
      "require": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      }
    }
  },
  "types": "./dist/cvz-widget.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "npm run build && (tailwindcss -i ./src/styles/global.css -o ./src/styles/output.css --watch & tsup --watch)",
    "build": "tailwindcss -i ./src/styles/global.css -o ./src/styles/output.css && tsup",
    "lint": "eslint src",
    "smoke": "node scripts/smoke-core.mjs",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build"
  },
  "keywords": [
    "chat",
    "widget",
    "chatbot",
    "converzen",
    "sdk",
    "react",
    "typescript"
  ],
  "author": "ConverZen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/converzen/chat-widget.git"
  },
  "bugs": {
    "url": "https://github.com/converzen/chat-widget/issues"
  },
  "homepage": "https://github.com/converzen/chat-widget#readme",
  "peerDependencies": {
    "react": "^18 || ^19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@headlessui/react": "^1.7.0",
    "@heroicons/react": "^2.0.0",
    "@types/react": "^18.0.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "preact": "^10.19.0",
    "react": "^18.3.1",
    "react-markdown": "^9.0.0",
    "remark-gfm": "^4.0.0",
    "tailwindcss": "^3.4.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "allowScripts": {
    "esbuild@0.27.2": true
  }
}
