{
  "name": "@converzent/chat-widget",
  "version": "1.0.0",
  "description": "Drop-in chat widget SDK for ConverZent - Easy to integrate, customizable, and fully featured chat widget",
  "main": "./dist/index.global.js",
  "browser": "./dist/index.global.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "npm run build && (tailwindcss -i ./src/styles/global.css -o ./src/styles/output.css --watch & tsup --watch)",
    "build": "tailwindcss -i ./src/styles/global.css -o ./src/styles/output.css && tsup",
    "lint": "eslint src",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "chat",
    "widget",
    "chatbot",
    "converzent",
    "sdk",
    "react",
    "typescript"
  ],
  "author": "ConverZent",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/converzent/chat-widget.git"
  },
  "bugs": {
    "url": "https://github.com/converzent/chat-widget/issues"
  },
  "homepage": "https://github.com/converzent/chat-widget#readme",
  "devDependencies": {
    "@headlessui/react": "^1.7.0",
    "@heroicons/react": "^2.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-markdown": "^9.0.0",
    "remark-gfm": "^4.0.0",
    "tailwindcss": "^3.4.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}
