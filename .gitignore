# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Build output - NOT tracked on branches. gmc-v2/cvz-web install this package
# as a git dependency pinned to a tag (github:converzen/chat-widget#vX.Y.Z),
# and `prepare` can't be relied on in sandboxed installs, so the built dist/
# is committed only into the tagged release commit, which sits on no branch.
# Create releases with `scripts/release.sh X.Y.Z` (see docs/PUBLISHING.md).
# Keeping dist/ off branches avoids merge conflicts in generated bundles.
/dist
/.claude
/.worktrees
/.idea/
/src/old/
# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
