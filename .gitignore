# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Build output - keep dist/ for CDN, but ignore in git
# dist/ is included in npm package via package.json "files" field
# Uncomment the line below if you want to exclude dist from git
/.worktrees
/dist/

/.idea/
/src/old/
# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
