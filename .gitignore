# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Build output - tracked in git (not ignored): gmc-v2 and other consumers
# install this package as a git dependency (github:converzen/chat-widget#tag),
# not from the npm registry, so `dist/` must exist in the checkout itself -
# there's no `npm publish` step to build it, and lifecycle scripts
# (`prepare`) are blocked outright in some install environments (confirmed:
# a sandboxed npm install here silently skipped it, leaving dist/ missing).
# Rebuild with `npm run build` before committing a change to src/.
/.claude
/.worktrees

/.idea/
/src/old/
# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
